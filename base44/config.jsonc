{
  "name": "Top 7",
  "description": "Top 7 is a running training and coaching platform for athletes and coaches. Coaches build and assign workouts and training plans, athletes follow daily training, and teams track workout completion, progress, feedback, race goals, shoe mileage, streaks, race predictions, and performance analytics.",
  "site": {
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "serveCommand": "npm run dev",
    "outputDirectory": "./dist"
  }
}